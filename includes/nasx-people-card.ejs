```{=html}
<div class="faculty-grid">
    <% for (const item of items) { %>
        <% const href = item.path && item.path !== "#" ? item.path : null; %>
        <% const prefix = (templateParams && templateParams.path_prefix) || ""; %>
        <% /* Opening and closing tags are written literally inside if-blocks.
              Building them in an output expression does not work here: Quarto's
              EJS escapes expression output, so the markup would appear on the
              page as visible text instead of becoming an element. */ %>
        <% if (href) { %>
            <a href="<%= href %>" class="f-card">
        <% } else { %>
            <div class="f-card">
        <% } %>
            <div class="f-photo">
                <% if (item.image) { %>
                    <img src="<%= prefix %><%= item.image %>" alt="<%= item.title %>" loading="lazy" decoding="async" />
                <% } %>
            </div>
            <strong><%= item.title %></strong>
            <% if (item.subtitle) { %>
                <span class="role"><%= item.subtitle %></span>
            <% } %>
        <% if (href) { %>
            </a>
        <% } else { %>
            </div>
        <% } %>
    <% } %>
</div>
```
