
```{=html}
<div class="listing-section">
    <% if (items.length > 0) { %>
        <div class="listing-grid">
            <% for (const item of items) { %>
                <a href="<%= item.path %>" class="team-member-card">
                    <% if (templateParams && templateParams.path_prefix) { %>
                        <img src="<%= templateParams.path_prefix %><%= item.image %>" alt="<%= item.title %>" />
                    <% } else { %>
                        <img src="<%= item.image %>" alt="<%= item.title %>" />
                    <% } %>
                    <div class="team-member-info">
                        <h2><%= item.title %></h2>
                        <% if (item.subtitle) { %>
                            <p><%= item.subtitle %></p>
                        <% } else { %>
                            <p>  </p>
                        <% } %>
                    </div>
                </a>
            <% } %>
        </div>
    <% } else { %>
        <p>No items found.</p>
    <% } %>
</div>
```
